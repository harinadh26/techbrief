# TechBrief Backend Environment Configuration

# Anthropic Claude API Key (Optional for development; if not set, high-fidelity fallback summaries are used)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model for summarization (Claude Haiku)
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Cache duration in seconds (1800s = 30 minutes)
CACHE_DURATION_SECONDS=1800

# Server Port
PORT=8000
